# Obsidian: la config del vault sí se versiona, el estado de la sesión no.
# Ojo: si un fichero ya está trackeado, .gitignore no le afecta.
# Hay quesacarlo del índice una vez con `git rm --cached <fichero>`.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json

