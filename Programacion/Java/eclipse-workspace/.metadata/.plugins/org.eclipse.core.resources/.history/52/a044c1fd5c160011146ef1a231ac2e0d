package ActividadesArray;

public class Alumno implements Comparable<Alumno> {
    // Atributos (Sin @Override aquí)
    double nota;
    String nombre;

    public Alumno(double nota, String nombre) {
        this.nota = nota;
        this.nombre = nombre;
    }

    // ESTO ES LO QUE FALTA PARA QUE Arrays.sort(clase) NO DE ERROR
    @Override
    public int compareTo(Alumno otro) {
        // Comparamos notas (Tema 4.3, pág 22)
        if (this.nota < otro.nota) return -1;
        if (this.nota > otro.nota) return 1;
        return 0;
    }
}