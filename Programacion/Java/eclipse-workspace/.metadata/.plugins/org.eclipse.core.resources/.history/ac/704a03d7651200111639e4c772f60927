package OrdenacionAlumnosClase;



public class Alumno {
	
	private String nombre;
	
	private double nota;
	
	
	public void double  setNota(double nota) throw new NotaInvalidaExcepcion{
		
		if(nota < 0) {
			throw new NotaInvalidaExcepcion();
		}
		else {
			this.nota = nota;
		}
	}
	
	public double getNotas() {
		return this.nota;
	}
	
	
}



